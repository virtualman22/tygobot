DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
# Optional: register commands to one server instantly. Leave empty for global (takes up to ~1h).
GUILD_ID=your-server-id
# Set to true ONLY after enabling "Server Members Intent" and "Message Content Intent"
# in the Developer Portal. Needed for welcome messages and the link filter.
ENABLE_PRIVILEGED_INTENTS=false
